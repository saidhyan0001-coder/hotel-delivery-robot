<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hotel_robot">

  <!-- ==================================================================== -->
  <!-- PROPERTIES & CONSTANTS                                              -->
  <!-- ==================================================================== -->
  <xacro:property name="chassis_length" value="0.35"/>
  <xacro:property name="chassis_width"  value="0.35"/>
  <xacro:property name="chassis_height" value="0.80"/>
  <xacro:property name="chassis_mass"   value="15.0"/>

  <xacro:property name="wheel_radius"  value="0.05"/>
  <xacro:property name="wheel_width"   value="0.025"/>
  <xacro:property name="wheel_mass"    value="0.5"/>
  <xacro:property name="track_width"   value="0.30"/>

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.2"/>

  <!-- Material Definitions -->
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.4 0.8 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- Inertia Macros -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1/12)*m*(h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*m*(w*w + d*d)}" iyz="0.0"
               izz="${(1/12)*m*(w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1/12)*m*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*m*(3*r*r + h*h)}" iyz="0.0"
               izz="${(1/2)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================================================================== -->
  <!-- BASE FOOTPRINT & BASE LINK                                          -->
  <!-- ==================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Main Chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" w="${chassis_width}" h="${chassis_height}" d="${chassis_length}"/>
  </link>

  <!-- ==================================================================== -->
  <!-- DRIVE WHEELS                                                        -->
  <!-- ==================================================================== -->
  <!-- Left Wheel -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Wheel -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- PASSIVE CASTER WHEELS                                                -->
  <!-- ==================================================================== -->
  <link name="front_caster">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${caster_mass}" r="${caster_radius}" h="${caster_radius}"/>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="${chassis_length/2 - 0.05} 0 -${caster_radius}" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${caster_mass}" r="${caster_radius}" h="${caster_radius}"/>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-${chassis_length/2 - 0.05} 0 -${caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- SENSORS                                                              -->
  <!-- ==================================================================== -->

  <!-- 1. 2D LiDAR Scanner -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- 2. IMU Sensor -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- 3. Upward-Facing Camera (Ceiling AprilTag) -->
  <link name="ceiling_camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="ceiling_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ceiling_camera_link"/>
    <origin xyz="0 0 ${chassis_height}" rpy="0 -${pi/2} 0"/>
  </joint>

  <!-- 4. Ultrasonic Sensors (HC-SR04) -->
  <link name="ultrasonic_fl_link">
    <visual>
      <geometry>
        <box size="0.01 0.04 0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="ultrasonic_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_fl_link"/>
    <origin xyz="${chassis_length/2} 0.12 0.08" rpy="0 0 ${pi/6}"/>
  </joint>

  <link name="ultrasonic_fc_link">
    <visual>
      <geometry>
        <box size="0.01 0.04 0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="ultrasonic_fc_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_fc_link"/>
    <origin xyz="${chassis_length/2} 0.0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="ultrasonic_fr_link">
    <visual>
      <geometry>
        <box size="0.01 0.04 0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="ultrasonic_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_fr_link"/>
    <origin xyz="${chassis_length/2} -0.12 0.08" rpy="0 0 -${pi/6}"/>
  </joint>

  <!-- ==================================================================== -->
  <!-- GAZEBO MATERIALS & ROS PLUGINS                                      -->
  <!-- ==================================================================== -->

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="left_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="front_caster">
    <material>Gazebo/Black</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="rear_caster">
    <material>Gazebo/Black</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="laser_frame">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- 1. Differential Drive Plugin -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_diameter>${wheel_radius*2}</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 2. 2D LiDAR Ray Sensor Plugin -->
  <gazebo reference="laser_frame">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 3. IMU Sensor Plugin -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data_raw</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 4. Upward Ceiling Camera Plugin -->
  <gazebo reference="ceiling_camera_link">
    <sensor type="camera" name="ceiling_camera">
      <update_rate>10</update_rate>
      <camera name="ceiling">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>5.0</far>
        </clip>
      </camera>
      <plugin name="ceiling_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=ceiling_camera/image_raw</remapping>
        </ros>
        <camera_name>ceiling_camera</camera_name>
        <frame_name>ceiling_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 5. Ultrasonic Sensors Plugins -->
  <!-- Front-Left Ultrasonic -->
  <gazebo reference="ultrasonic_fl_link">
    <sensor type="ray" name="ultrasonic_fl">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.13</min_angle>
            <max_angle>0.13</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>2.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_ultrasonic_fl" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=ultrasonic/front_left</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
        <frame_name>ultrasonic_fl_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Front-Center Ultrasonic -->
  <gazebo reference="ultrasonic_fc_link">
    <sensor type="ray" name="ultrasonic_fc">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.13</min_angle>
            <max_angle>0.13</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>2.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_ultrasonic_fc" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=ultrasonic/front_center</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
        <frame_name>ultrasonic_fc_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Front-Right Ultrasonic -->
  <gazebo reference="ultrasonic_fr_link">
    <sensor type="ray" name="ultrasonic_fr">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.13</min_angle>
            <max_angle>0.13</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>2.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_ultrasonic_fr" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=ultrasonic/front_right</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
        <frame_name>ultrasonic_fr_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
