<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>hotel_robot_navigation</name>
  <version>1.0.0</version>
  <description>Nav2 configuration, costmaps, EKF parameters, and master system launch for Autonomous Hotel Delivery Robot</description>
  <maintainer email="dev@hotelrobot.com">Hotel Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>hotel_robot_description</exec_depend>
  <exec_depend>hotel_robot_hardware</exec_depend>
  <exec_depend>hotel_robot_perception</exec_depend>
  <exec_depend>vapi_llm_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
