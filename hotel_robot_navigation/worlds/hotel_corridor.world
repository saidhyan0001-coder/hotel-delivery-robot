<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hotel_corridor_world">
    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Sun Light Source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Physics Parameters -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Hotel Lobby & Corridor Wall Structure -->
    <!-- Main Corridor Left Wall -->
    <model name="corridor_wall_left">
      <pose>10.0 2.5 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>25.0 0.2 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>25.0 0.2 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Main Corridor Right Wall -->
    <model name="corridor_wall_right">
      <pose>10.0 -2.5 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>25.0 0.2 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>25.0 0.2 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room 301 Door Pillar -->
    <model name="room_301_wall">
      <pose>5.0 1.5 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 1.8 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 1.8 2.0</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Room 302 Door Pillar -->
    <model name="room_302_wall">
      <pose>10.0 1.5 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 1.8 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 1.8 2.0</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Room 304 Door Pillar -->
    <model name="room_304_wall">
      <pose>20.0 1.5 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 1.8 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 1.8 2.0</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Scene Lighting -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
  </world>
</sdf>
